# Copy to .env (git-ignored). Every NEXT_PUBLIC_ value ships to the device — never put secrets here.
# Validated at startup by lib/env.ts. See TECH_SPEC §3.4.

# local | staging | production
NEXT_PUBLIC_APP_ENV=local

# Optional. Without these the app runs fully local-first and account features show RR-AUTH-008.
# Supabase project "Master of Projects" (shared; this app lives in the app_routine_raccoon schema).
# Use the publishable key (sb_publishable_...), never the sb_secret_ key.
NEXT_PUBLIC_SUPABASE_URL=https://kvccsypvuoyycfoozcew.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional. Error monitoring; leave empty locally.
NEXT_PUBLIC_SENTRY_DSN=

# Test builds only: lets ?__fault=RR-XXX-000 force an error screen on any route.
# The build refuses this when NEXT_PUBLIC_APP_ENV=production.
NEXT_PUBLIC_ENABLE_FAULTS=0

# Dev only: seed the prototype's demo routine into an empty database.
NEXT_PUBLIC_SEED_DEMO=1
